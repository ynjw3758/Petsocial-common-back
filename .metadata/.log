                 		logger.info("비디오 파일 ");
                 		url.add(file_list.get(0).get("thumbnail_url").toString());
                 		
                 	}
                 	else{
                 		url.add(file_list.get(0).get("url").toString());
                 	}
                 	

               	 logger.info("url :" + url.get(0));

                 	
                 }
                 total_data.put("url", url);
                 total_data.put("user_data", saerch_data);
            }
            else {
                total_data.put("url", "null");
                total_data.put("user_data",saerch_data);
            };

            data.put("resultcode", 200);
            data.put("resultmsg", "success");
            data.put("resultdata", total_data);

		return data;
	}
	
	
